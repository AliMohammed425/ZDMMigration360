# ZDMMigration360 Standby Manager configuration

SOURCE_HOST=
SOURCE_OS_USER=oracle
SOURCE_ORACLE_HOME=
SOURCE_SID=
SOURCE_DB_UNIQUE_NAME=
SOURCE_TNS_ALIAS=

TARGET_HOST=
TARGET_OS_USER=oracle
TARGET_ORACLE_HOME=
TARGET_SID=
TARGET_DB_UNIQUE_NAME=
TARGET_TNS_ALIAS=

# ACTIVE_DUPLICATE or OFFLINE_BACKUP
STANDBY_BUILD_METHOD=ACTIVE_DUPLICATE

# Runtime secrets should be injected from a secret manager/environment.
# Do not persist production passwords here.
# SOURCE_SYS_PASSWORD=
# TARGET_SYS_PASSWORD=

# OFFLINE_BACKUP options
SOURCE_BACKUP_STAGE=
TARGET_BACKUP_STAGE=
BACKUP_COPY_METHOD=SCP

# RAC target options
TARGET_RAC_ENABLED=NO
TARGET_RAC_INSTANCES=2
TARGET_GRID_HOME=
TARGET_UNDO_PREFIX=UNDOTBS
TARGET_REDO_SIZE_MB=0
RAC_CONVERSION_MODE=VALIDATE_ONLY

# Data Guard sync
SYNC_WAIT_SECONDS=900
SYNC_POLL_SECONDS=15

# Source database identity. DB_NAME must match on physical standby.
SOURCE_DB_NAME=
SOURCE_IS_CDB=YES

# OCI standby placeholder creation
# AUTO detects dbcli on OCI Base Database Service.
# Supported values: AUTO, BASE_DB_SERVICE_DBCLI, GENERIC_OCI_OR_SELF_MANAGED
OCI_TARGET_PLATFORM=AUTO
TARGET_PROVISION_OS_USER=opc

# TARGET_ADMIN_PASSWORD is required by dbcli --instanceonly.
# Inject it at runtime from a secret manager/environment; do not persist production secrets.
# TARGET_ADMIN_PASSWORD=

# Generic/self-managed OCI placeholder storage (optional if source SPFILE/RMAN supplies it)
TARGET_DB_CREATE_FILE_DEST=
TARGET_DB_RECOVERY_FILE_DEST=
TARGET_DB_RECOVERY_FILE_DEST_SIZE=

# TDE (only required if source encrypted tablespaces exist)
SOURCE_TDE_WALLET_PATH=
TARGET_TDE_WALLET_PATH=

# Optional fixed source archive destination slot
DG_ARCHIVE_DEST_ID=
