# ZDMMigration360 Physical Standby Driver
# Copy to zdm360PH.drv and edit.
# Protect with chmod 600 when secrets are included.

SOURCE_DB_NAME=ORCL
SOURCE_DB_UNIQUE_NAME=ORCLPRD
SOURCE_SID=ORCL1
SOURCE_HOST=primary01
SOURCE_OS_USER=oracle
SOURCE_ORACLE_HOME=/u01/app/oracle/product/19.0.0/dbhome_1
SOURCE_LISTENER_PORT=1521
SOURCE_SERVICE=ORCLPRD
SOURCE_IS_CDB=YES
SOURCE_TNS_ALIAS=ORCLPRD_SRC
SOURCE_SYS_PASSWORD=

TARGET_DB_NAME=ORCL
TARGET_DB_UNIQUE_NAME=ORCLSTBY
TARGET_SID=ORCL1
TARGET_HOST=standby01
TARGET_OS_USER=oracle
TARGET_PROVISION_OS_USER=opc
TARGET_ORACLE_HOME=/u01/app/oracle/product/19.0.0/dbhome_1
TARGET_LISTENER_PORT=1521
TARGET_AUX_PORT=1529
TARGET_AUX_LISTENER_NAME=LISTENER_ZDM360
TARGET_SERVICE=ORCLSTBY
TARGET_TNS_ALIAS=ORCLSTBY_TGT
TARGET_SYS_PASSWORD=
TARGET_ADMIN_PASSWORD=

OCI_TARGET_PLATFORM=AUTO
TARGET_DB_CREATE_FILE_DEST=+DATA
TARGET_DB_RECOVERY_FILE_DEST=+RECO
TARGET_DB_RECOVERY_FILE_DEST_SIZE=500G

STANDBY_BUILD_METHOD=ACTIVE_DUPLICATE
SOURCE_BACKUP_STAGE=
TARGET_BACKUP_STAGE=
BACKUP_COPY_METHOD=SCP

TARGET_RAC_ENABLED=NO
TARGET_RAC_INSTANCES=2
TARGET_GRID_HOME=
TARGET_UNDO_PREFIX=UNDOTBS
TARGET_REDO_SIZE_MB=0
RAC_CONVERSION_MODE=VALIDATE_ONLY

SYNC_WAIT_SECONDS=1800
SYNC_POLL_SECONDS=15
FULL_BUILD_BACKGROUND=YES

# TDE (only required if source encrypted tablespaces exist)
SOURCE_TDE_WALLET_PATH=
TARGET_TDE_WALLET_PATH=

# Optional fixed source archive destination slot
DG_ARCHIVE_DEST_ID=


# ZDM physical migration execution from target
# Leave ZDM_TARGET_HOME blank for auto-detection.
ZDM_TARGET_HOME=
# Response file MUST exist on the target ZDM host and contain the complete,
# Oracle-supported physical migration configuration for this environment.
ZDM_RSP_FILE=
# Private SSH key path as seen on the target ZDM host, for source access.
ZDM_SOURCE_SSH_KEY=
SOURCE_SUDO_LOCATION=/usr/bin/sudo
# ONLINE_PHYSICAL uses Data Guard; OFFLINE_PHYSICAL uses backup/restore.
ZDM_PHYSICAL_METHOD=ONLINE_PHYSICAL
# YES = online workflow pauses after ZDM_CONFIGURE_DG_SRC when that phase is valid.
ZDM_PAUSE_AFTER_STANDBY=YES


# Operator security policy
# Run the toolkit as ops. Database SSH is performed as oracle.
TOOLKIT_OS_USER=ops
ORACLE_OS_USER=oracle
REQUIRE_LOCAL_SUDO_ORACLE=YES
REQUIRE_TARGET_ORACLE_SSH=YES
REQUIRE_SOURCE_ORACLE_SSH=YES
SSH_CONNECT_TIMEOUT=10
