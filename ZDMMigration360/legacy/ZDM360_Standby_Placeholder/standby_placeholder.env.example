# Secrets are intentionally omitted from this file.
# Interactive mode prompts securely for:
#   SOURCE_SYS_PASSWORD
#   SOURCE_TDE_PASSWORD
#
# For non-interactive automation, inject them from your approved secret manager:
# export SOURCE_SYS_PASSWORD="..."
# export SOURCE_TDE_PASSWORD="..."

# Optional runtime secret variables for consistency checking:
# export TARGET_SYS_PASSWORD="..."   # must match SOURCE_SYS_PASSWORD
# export TARGET_TDE_PASSWORD="..."   # must match SOURCE_TDE_PASSWORD
